<section>
  <div class="card">
    <div class="card-body">
      <%= tag.h3 do %>
        <%= tag.span OmniArticle::Article.model_name.human %>
        <% if current_tenant || current_organization %>
          <%= link_to admin_article_list_entry_path, data: { turbo_frame: "modal" },
            class: "icon-text text-info ms-2", title: t("omni_article.article_list_entry"),
            aria: { label: t("omni_article.article_list_entry") } do %>
            <%= tag.span inline_svg_tag("easy_style/icon_qrcode.svg"), class: "vertical-align-middle" %>
          <% end %>
        <% end %>
      <% end %>

      <div class="d-flex flex-wrap align-items-start gap-2 mb-3">
        <%= render "search_form", q: @q %>

        <div class="ms-auto">
          <% if policy([:omni_article, :admin, OmniArticle::Article.new]).new? %>
            <%= link_to new_admin_article_path, class: "btn btn-primary" do %>
              <%= tag.span inline_svg_tag("easy_style/icon_add.svg") %>
              <%= tag.span t("omni_article.add") %>
            <% end %>
          <% end %>
        </div>
      </div>

      <%= render "data_table", articles: @articles %>
    </div>
  </div>
</section>
