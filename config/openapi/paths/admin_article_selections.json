{
  "get": {
    "summary": "Find articles available for selection",
    "parameters": [
      {
        "name": "q",
        "in": "query",
        "schema": {
          "type": "string",
          "maxLength": 160
        }
      },
      {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      {
        "name": "per",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 }
      }
    ],
    "responses": {
      "200": {
        "description": "A page of article options within the authenticated account's article scope, matched by title, UID or numeric ID.",
        "headers": {
          "X-Page": { "schema": { "type": "integer" } },
          "X-Per-Page": { "schema": { "type": "integer" } },
          "X-Total-Count": { "schema": { "type": "integer" } },
          "X-Total-Pages": { "schema": { "type": "integer" } }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "uid",
                  "title"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "uid": {
                    "type": "string"
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "401": {
        "description": "Authentication required"
      },
      "403": {
        "description": "Permission to view the admin article list is required"
      }
    }
  }
}
